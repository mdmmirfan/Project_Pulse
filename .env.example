# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env (it is gitignored).
# These are OPTIONAL — the core notebook runs without any of them.

# Genius API (lyrics) — only if you re-enable lyrical sentiment
GENIUS_API_TOKEN=

# Spotify Web API — only if you pull your live listening history (future v2)
# Create an app at https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
